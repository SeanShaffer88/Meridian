<Window
    x:Class="Meridian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Meridian.Models"
    Title="Meridian">
  <Grid Background="#17191D" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <Grid Grid.Row="0" Margin="18,14" ColumnDefinitions="Auto,*,Auto" Background="#202329">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="8" Background="#F04444">
          <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="0"><TextBlock Text="MERIDIAN" FontSize="16" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock Text="FILE MANAGER" FontSize="10" Foreground="#9CA3AF" CharacterSpacing="100" /></StackPanel>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="Your files. Your workflow." Foreground="#9CA3AF" VerticalAlignment="Center" HorizontalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="PREVIEW BUILD" FontSize="10" Foreground="#F04444" VerticalAlignment="Center" CharacterSpacing="80" />
    </Grid>
    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="#1B1D22">
      <AppBarButton Icon="Copy" Label="Copy L → R" Click="CopyLeftToRight_Click" />
      <AppBarButton Icon="Copy" Label="Copy R → L" Click="CopyRightToLeft_Click" />
      <AppBarButton Icon="Add" Label="New folder" Click="NewFolder_Click" />
      <AppBarButton Icon="Rename" Label="Rename" Click="RenameSelected_Click" />
      <AppBarButton Icon="View" Label="Properties" Click="PropertiesSelected_Click" />
      <AppBarButton Icon="Delete" Label="Delete" Click="DeleteSelected_Click" />
      <AppBarSeparator />
      <AppBarButton x:Name="CancelCopyButton" Icon="Cancel" Label="Cancel copy" IsEnabled="False" Click="CancelCopy_Click" />
      <AppBarButton Icon="Refresh" Label="Refresh both" Click="RefreshBoth_Click" />
      <AppBarButton Icon="OpenFolder" Label="Open in Explorer" Click="OpenInExplorer_Click" />
    </CommandBar>
    <Grid Grid.Row="2" Margin="12,4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="WorkspaceTabsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" /></ScrollViewer>
      <Button Grid.Column="1" Content="+ New tab" Click="AddWorkspaceTab_Click" />
    </Grid>
    <Grid Grid.Row="3" Margin="12,6" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
      <Button Content="★ Add bookmark" Click="AddBookmark_Click" />
      <Button Grid.Column="1" Content="Remove bookmark" Click="RemoveBookmark_Click" />
      <TextBlock Grid.Column="2" Text="SAVED LOCATIONS" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" />
      <ComboBox x:Name="BookmarksBox" Grid.Column="3" PlaceholderText="Jump to a saved location…" DisplayMemberPath="Name" SelectionChanged="BookmarksBox_SelectionChanged" HorizontalAlignment="Stretch" />
    </Grid>
    <Grid Grid.Row="4" Margin="12" ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Background="#202329" PointerPressed="LeftPane_PointerPressed">
        <Grid Margin="12,10" ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Text="01" Foreground="#F04444" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="SOURCE PANE" FontSize="11" CharacterSpacing="100" Foreground="#9CA3AF" /></Grid>
        <Grid Grid.Row="1" Margin="10,0,10,10" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Content="←" Click="LeftBack_Click" MinWidth="32" /><Button Grid.Column="1" Content="→" Click="LeftForward_Click" MinWidth="32" /><Button Grid.Column="2" Content="↑" Click="LeftUp_Click" MinWidth="32" />
          <TextBox x:Name="LeftPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="LeftPath_KeyDown" />
        </Grid>
        <ListView x:Name="LeftItems" Grid.Row="2" SelectionMode="Single" DoubleTapped="LeftItems_DoubleTapped" PointerPressed="LeftItems_PointerPressed" Background="Transparent" BorderThickness="0" Margin="4,0">
          <ListView.ItemTemplate><DataTemplate x:DataType="models:FileEntry">
            <Grid Margin="8,7" ColumnDefinitions="Auto,*,100,130" ColumnSpacing="10">
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="#F04444" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="LeftStatus" Grid.Row="3" Text="Ready" FontSize="11" Foreground="#9CA3AF" Margin="12,8" />
      </Grid>
      <Grid Grid.Column="1" Width="36" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Button Grid.Row="0" Content="→" ToolTipService.ToolTip="Copy selected item to right pane" Click="CopyLeftToRight_Click" />
        <Button Grid.Row="1" Content="←" ToolTipService.ToolTip="Copy selected item to left pane" Click="CopyRightToLeft_Click" />
        <TextBlock Grid.Row="2" Text="COPY" FontSize="9" Foreground="#9CA3AF" HorizontalAlignment="Center" />
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Background="#202329" PointerPressed="RightPane_PointerPressed">
        <Grid Margin="12,10" ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Text="02" Foreground="#F04444" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="DESTINATION PANE" FontSize="11" CharacterSpacing="100" Foreground="#9CA3AF" /></Grid>
        <Grid Grid.Row="1" Margin="10,0,10,10" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Content="←" Click="RightBack_Click" MinWidth="32" /><Button Grid.Column="1" Content="→" Click="RightForward_Click" MinWidth="32" /><Button Grid.Column="2" Content="↑" Click="RightUp_Click" MinWidth="32" />
          <TextBox x:Name="RightPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="RightPath_KeyDown" />
        </Grid>
        <ListView x:Name="RightItems" Grid.Row="2" SelectionMode="Single" DoubleTapped="RightItems_DoubleTapped" PointerPressed="RightItems_PointerPressed" Background="Transparent" BorderThickness="0" Margin="4,0">
          <ListView.ItemTemplate><DataTemplate x:DataType="models:FileEntry">
            <Grid Margin="8,7" ColumnDefinitions="Auto,*,100,130" ColumnSpacing="10">
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="#F04444" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="RightStatus" Grid.Row="3" Text="Ready" FontSize="11" Foreground="#9CA3AF" Margin="12,8" />
      </Grid>
    </Grid>
    <Grid Grid.Row="5" Margin="14,9" ColumnDefinitions="Auto,*,Auto" Background="#202329">
      <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="GlobalStatus" Text="Ready · Local-only · No telemetry" FontSize="11" Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="MERIDIAN · EARLY DEVELOPMENT" FontSize="10" Foreground="#6B7280" CharacterSpacing="70" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
