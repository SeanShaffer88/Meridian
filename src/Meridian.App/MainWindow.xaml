<Window
    x:Class="Meridian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Meridian.Models"
    Title="Meridian">
  <Grid Background="{ThemeResource MeridianSurfaceBrush}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F5" Invoked="RefreshShortcut_Invoked" />
      <KeyboardAccelerator Key="F6" Invoked="SwitchPaneShortcut_Invoked" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusActivePathShortcut_Invoked" />
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusActiveFilterShortcut_Invoked" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackShortcut_Invoked" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardShortcut_Invoked" />
      <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="UpShortcut_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid Grid.Row="0" Margin="{StaticResource MeridianHeaderMargin}" Background="{ThemeResource MeridianPanelBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource MeridianAccentBrush}">
          <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource MeridianOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="0"><TextBlock Text="MERIDIAN" FontSize="16" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock Text="FILE MANAGER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" /></StackPanel>
      </StackPanel>
    </Grid>
    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="{ThemeResource MeridianChromeBrush}">
      <AppBarElementContainer>
        <SplitButton Click="CopyActivePane_Click" ToolTipService.ToolTip="Copy the selected item from the active pane to the other pane">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Copy" />
            <TextBlock Text="Copy" VerticalAlignment="Center" />
          </StackPanel>
          <SplitButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Copy left → right" Click="CopyLeftToRight_Click" />
              <MenuFlyoutItem Text="Copy right → left" Click="CopyRightToLeft_Click" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </AppBarElementContainer>
      <AppBarElementContainer>
        <SplitButton Click="MoveActivePane_Click" ToolTipService.ToolTip="Move the selected item from the active pane to the other pane">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="MoveToFolder" />
            <TextBlock Text="Move" VerticalAlignment="Center" />
          </StackPanel>
          <SplitButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Move left → right" Click="MoveLeftToRight_Click" />
              <MenuFlyoutItem Text="Move right → left" Click="MoveRightToLeft_Click" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </AppBarElementContainer>
      <AppBarButton Icon="Add" Label="New folder" Click="NewFolder_Click" />
      <AppBarButton Icon="Rename" Label="Rename" Click="RenameSelected_Click" />
      <AppBarButton Icon="View" Label="Properties" Click="PropertiesSelected_Click" />
      <AppBarButton Icon="Setting" Label="Tools">
        <AppBarButton.Flyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Folder DNA" Click="FolderDna_Click" ToolTipService.ToolTip="Profile the current folder without scanning subfolders" />
            <MenuFlyoutItem Text="Operation Simulator" Click="PreviewShelf_Click" ToolTipService.ToolTip="Inspect all collected items against the active folder without copying anything" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Save Capsule" Click="SaveCapsule_Click" ToolTipService.ToolTip="Save current shelf path references locally; file contents are not copied" />
            <MenuFlyoutItem Text="View Capsules" Click="ViewCapsules_Click" ToolTipService.ToolTip="Review locally saved task references, including unavailable paths" />
          </MenuFlyout>
        </AppBarButton.Flyout>
      </AppBarButton>
      <AppBarButton Icon="Delete" Label="Delete" Click="DeleteSelected_Click" />
      <AppBarSeparator />
      <AppBarButton x:Name="CancelCopyButton" Icon="Cancel" Label="Cancel copy" IsEnabled="False" Click="CancelCopy_Click" />
      <AppBarButton Icon="Refresh" Label="Refresh both" Click="RefreshBoth_Click" />
      <AppBarButton Icon="OpenFolder" Label="Open in Explorer" Click="OpenInExplorer_Click" />
    </CommandBar>
    <Grid Grid.Row="2" Margin="{StaticResource MeridianChromeMargin}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="WorkspaceTabsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" /></ScrollViewer>
      <Button Grid.Column="1" Content="+ New tab" Click="AddWorkspaceTab_Click" />
    </Grid>
    <Grid Grid.Row="3" Margin="{StaticResource MeridianChromeMargin}" RowDefinitions="Auto,Auto">
      <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="ORGANIZE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
        <ToggleButton x:Name="BookmarksSectionToggle" Grid.Column="1" Content="Bookmarks" Click="OrganizeSection_Click" ToolTipService.ToolTip="Show or hide saved locations" />
        <ToggleButton x:Name="ShelfSectionToggle" Grid.Column="2" Content="Drop Shelf" Click="OrganizeSection_Click" ToolTipService.ToolTip="Show or hide the Drop Shelf tools" />
      </Grid>
      <Grid x:Name="BookmarksSection" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Content="★ Add bookmark" Click="AddBookmark_Click" />
        <Button Grid.Column="1" Content="Remove bookmark" Click="RemoveBookmark_Click" />
        <TextBlock Grid.Column="2" Text="SAVED LOCATIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
        <ComboBox x:Name="BookmarksBox" Grid.Column="3" PlaceholderText="Jump to a saved location…" DisplayMemberPath="Name" SelectionChanged="BookmarksBox_SelectionChanged" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid x:Name="ShelfSection" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Content="＋ Shelf selected" Click="AddToShelf_Click" ToolTipService.ToolTip="Collect the selected file or folder without moving it" />
        <Button Grid.Column="1" Content="Remove from shelf" Click="RemoveFromShelf_Click" />
        <Button Grid.Column="2" Content="Clear shelf" Click="ClearShelf_Click" />
        <Button Grid.Column="3" Content="Prune missing" Click="PruneShelf_Click" ToolTipService.ToolTip="Remove missing paths from the shelf without deleting files" />
        <Button Grid.Column="4" Content="Show location" Click="ShowShelfLocation_Click" />
        <Button Grid.Column="5" Content="Preview shelf → active folder" Click="PreviewShelf_Click" ToolTipService.ToolTip="Inspect all collected items against the active folder without copying anything" />
        <Button Grid.Column="6" Content="Copy shelf…" Click="CopyShelf_Click" ToolTipService.ToolTip="Preview and confirm a no-overwrite batch copy" />
        <Button x:Name="CancelShelfButton" Grid.Column="7" Content="Cancel batch" Click="CancelShelf_Click" IsEnabled="False" />
        <ComboBox x:Name="ShelfItemsBox" Grid.Column="8" PlaceholderText="Drop Shelf · collect items from any folder" HorizontalAlignment="Stretch" />
      </Grid>
    </Grid>
    <Grid Grid.Row="4" Margin="{StaticResource MeridianWorkAreaMargin}" ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
      <Grid x:Name="LeftPaneRoot" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{ThemeResource MeridianPanelBrush}" BorderThickness="0,2,0,0" BorderBrush="{ThemeResource MeridianBorderBrush}" PointerPressed="LeftPane_PointerPressed">
        <Grid x:Name="LeftPaneHeader" Padding="{StaticResource MeridianPaneHeaderMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="01" Foreground="{ThemeResource MeridianTextTertiaryBrush}" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Spacing="0">
            <TextBlock x:Name="LeftFolderName" Text="Source pane" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="LeftFolderPath" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Click="LeftBack_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Back"><SymbolIcon Symbol="Back" /></Button><Button Grid.Column="1" Click="LeftForward_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Forward"><SymbolIcon Symbol="Forward" /></Button><Button Grid.Column="2" Click="LeftUp_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Up"><SymbolIcon Symbol="Up" /></Button>
          <TextBox x:Name="LeftPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="LeftPath_KeyDown" />
        </Grid>
        <Grid Grid.Row="2" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="LeftFilter" PlaceholderText="Filter files and folders…" TextChanged="LeftFilter_TextChanged" />
          <ComboBox x:Name="LeftSort" Grid.Column="1" MinWidth="110" SelectedIndex="0" SelectionChanged="LeftSort_SelectionChanged" ToolTipService.ToolTip="Sort this pane">
            <ComboBoxItem Content="Name" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Size" /><ComboBoxItem Content="Modified" />
          </ComboBox>
          <ToggleButton x:Name="LeftSortDescending" Grid.Column="2" Content="↓" ToolTipService.ToolTip="Descending sort" Checked="LeftSortDirection_Changed" Unchecked="LeftSortDirection_Changed" />
        </Grid>
        <ListView x:Name="LeftItems" Grid.Row="3" SelectionMode="Single" DoubleTapped="LeftItems_DoubleTapped" PointerPressed="LeftItems_PointerPressed" Background="Transparent" BorderThickness="0" Margin="4,0">
          <ListView.ItemTemplate><DataTemplate x:DataType="models:FileEntry">
            <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,100,130" ColumnSpacing="10">
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="LeftStatus" Grid.Row="4" Text="Ready" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="{StaticResource MeridianPaneStatusMargin}" />
      </Grid>
      <Grid Grid.Column="1" Width="36" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Button Grid.Row="0" Content="→" ToolTipService.ToolTip="Copy selected item to right pane" Click="CopyLeftToRight_Click" />
        <Button Grid.Row="1" Content="←" ToolTipService.ToolTip="Copy selected item to left pane" Click="CopyRightToLeft_Click" />
        <TextBlock Grid.Row="2" Text="COPY" FontSize="9" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" />
      </Grid>
      <Grid x:Name="RightPaneRoot" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{ThemeResource MeridianPanelBrush}" BorderThickness="0,2,0,0" BorderBrush="{ThemeResource MeridianBorderBrush}" PointerPressed="RightPane_PointerPressed">
        <Grid x:Name="RightPaneHeader" Padding="{StaticResource MeridianPaneHeaderMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="02" Foreground="{ThemeResource MeridianTextTertiaryBrush}" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Spacing="0">
            <TextBlock x:Name="RightFolderName" Text="Destination pane" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="RightFolderPath" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Click="RightBack_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Back"><SymbolIcon Symbol="Back" /></Button><Button Grid.Column="1" Click="RightForward_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Forward"><SymbolIcon Symbol="Forward" /></Button><Button Grid.Column="2" Click="RightUp_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Up"><SymbolIcon Symbol="Up" /></Button>
          <TextBox x:Name="RightPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="RightPath_KeyDown" />
        </Grid>
        <Grid Grid.Row="2" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="RightFilter" PlaceholderText="Filter files and folders…" TextChanged="RightFilter_TextChanged" />
          <ComboBox x:Name="RightSort" Grid.Column="1" MinWidth="110" SelectedIndex="0" SelectionChanged="RightSort_SelectionChanged" ToolTipService.ToolTip="Sort this pane">
            <ComboBoxItem Content="Name" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Size" /><ComboBoxItem Content="Modified" />
          </ComboBox>
          <ToggleButton x:Name="RightSortDescending" Grid.Column="2" Content="↓" ToolTipService.ToolTip="Descending sort" Checked="RightSortDirection_Changed" Unchecked="RightSortDirection_Changed" />
        </Grid>
        <ListView x:Name="RightItems" Grid.Row="3" SelectionMode="Single" DoubleTapped="RightItems_DoubleTapped" PointerPressed="RightItems_PointerPressed" Background="Transparent" BorderThickness="0" Margin="4,0">
          <ListView.ItemTemplate><DataTemplate x:DataType="models:FileEntry">
            <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,100,130" ColumnSpacing="10">
              <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{x:Bind ModifiedLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="RightStatus" Grid.Row="4" Text="Ready" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="{StaticResource MeridianPaneStatusMargin}" />
      </Grid>
    </Grid>
    <Grid Grid.Row="5" Margin="{StaticResource MeridianStatusBarMargin}" ColumnDefinitions="Auto,*" Background="{ThemeResource MeridianPanelBrush}">
      <Ellipse Width="7" Height="7" Fill="{ThemeResource MeridianSuccessBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="GlobalStatus" Text="Ready · Local-only · No telemetry" ToolTipService.ToolTip="Meridian · Preview build — early development" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
