<Window
    x:Class="Meridian.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Meridian.Models"
    xmlns:services="using:Meridian.Services"
    Title="Meridian">
  <Grid x:Name="RootGrid" Background="{ThemeResource MeridianSurfaceBrush}" RowDefinitions="Auto,Auto,*,Auto">
    <Grid.Resources>
      <DataTemplate x:Key="ColumnItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <FontIcon Grid.Column="2" Glyph="{x:Bind ChevronGlyph}" FontSize="12" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>
      <!-- Details view templates, one per adaptive column set (Name+Size+Age+Modified,
           then Modified hides, then Age, then Size; Name never hides). The Age text
           block is tagged so the window can tint it by age bucket per realized row. -->
      <DataTemplate x:Key="DetailsAllItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,100,110,130" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{x:Bind EffectiveSizeLabel, Mode=OneWay}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Tag="AgeColumn" Text="{x:Bind AgeLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{x:Bind ModifiedLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DetailsNoModifiedItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,100,110" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{x:Bind EffectiveSizeLabel, Mode=OneWay}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Tag="AgeColumn" Text="{x:Bind AgeLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DetailsSizeItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*,100" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{x:Bind EffectiveSizeLabel, Mode=OneWay}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DetailsNameItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
      </DataTemplate>
      <!-- Grid view: large thumbnail with the name below. The Image is tagged with
           the item path so the window can fill it asynchronously, recycling-safe. -->
      <DataTemplate x:Key="GridItemTemplate" x:DataType="models:FileEntry">
        <StackPanel Width="164" Padding="6,8" Spacing="6" AutomationProperties.Name="{x:Bind Name}">
          <Grid Width="152" Height="100" HorizontalAlignment="Center">
            <FontIcon Glyph="{x:Bind Glyph}" FontSize="40" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Tag="{x:Bind FullPath}" Width="152" Height="100" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DataTemplate>
      <!-- Tiles view: medium thumbnail left, name + type + size lines right. -->
      <DataTemplate x:Key="TileItemTemplate" x:DataType="models:FileEntry">
        <Grid Margin="{StaticResource MeridianListItemMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="10" AutomationProperties.Name="{x:Bind Name}">
          <Grid Width="48" Height="48">
            <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Tag="{x:Bind FullPath}" Width="48" Height="48" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind TypeLabel}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind EffectiveSizeLabel, Mode=OneWay}" Foreground="{ThemeResource MeridianTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="PaneGroupHeaderTemplate" x:DataType="services:PaneItemGroup">
        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="4,10,4,2" />
      </DataTemplate>
      <ItemsPanelTemplate x:Key="VerticalItemsPanel">
        <ItemsStackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="WrapItemsPanel">
        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="152" />
      </ItemsPanelTemplate>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F5" Invoked="RefreshShortcut_Invoked" />
      <KeyboardAccelerator Key="F6" Invoked="SwitchPaneShortcut_Invoked" />
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusActivePathShortcut_Invoked" />
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusActiveFilterShortcut_Invoked" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackShortcut_Invoked" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardShortcut_Invoked" />
      <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="UpShortcut_Invoked" />
      <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="NewFolderShortcut_Invoked" />
      <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyShortcut_Invoked" />
      <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="MoveShortcut_Invoked" />
      <KeyboardAccelerator Key="E" Modifiers="Control,Shift" Invoked="OpenInExplorerShortcut_Invoked" />
      <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="PropertiesShortcut_Invoked" />
      <KeyboardAccelerator Key="F2" Invoked="RenameShortcut_Invoked" />
      <KeyboardAccelerator Key="D" Modifiers="Control,Shift" Invoked="DetailsStripShortcut_Invoked" />
      <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="LayoutShortcut_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="CancelCopyShortcut_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid x:Name="AppTitleBar" Grid.Row="0" Margin="{StaticResource MeridianHeaderMargin}" Background="{ThemeResource MeridianPanelBrush}" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
      <Button Width="36" Height="36" Padding="0" VerticalAlignment="Center" Click="SidebarToggle_Click" ToolTipService.ToolTip="Show or hide the navigation sidebar" AutomationProperties.Name="Toggle navigation sidebar"><SymbolIcon Symbol="GlobalNavigationButton" /></Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="32" Height="32" CornerRadius="{StaticResource MeridianCardCornerRadius}" Background="{ThemeResource MeridianAccentBrush}">
          <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource MeridianOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="0"><TextBlock Text="MERIDIAN" FontSize="16" FontWeight="SemiBold" CharacterSpacing="90" /><TextBlock Text="FILE MANAGER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" /></StackPanel>
      </StackPanel>
      <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
        <AppBarElementContainer>
          <SplitButton Click="CopyActivePane_Click" AutomationProperties.Name="Copy" ToolTipService.ToolTip="Copy the selected items from the active pane to the other pane (Ctrl+Shift+C)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Copy" />
              <TextBlock Text="Copy" VerticalAlignment="Center" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Copy left \u2192 right" Click="CopyLeftToRight_Click" />
                <MenuFlyoutItem Text="Copy right \u2192 left" Click="CopyRightToLeft_Click" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </AppBarElementContainer>
        <AppBarElementContainer>
          <SplitButton Click="MoveActivePane_Click" AutomationProperties.Name="Move" ToolTipService.ToolTip="Move the selected items from the active pane to the other pane (Ctrl+Shift+M)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="MoveToFolder" />
              <TextBlock Text="Move" VerticalAlignment="Center" />
            </StackPanel>
            <SplitButton.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Move left \u2192 right" Click="MoveLeftToRight_Click" />
                <MenuFlyoutItem Text="Move right \u2192 left" Click="MoveRightToLeft_Click" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
        </AppBarElementContainer>
        <AppBarButton Icon="Add" Label="New folder" Click="NewFolder_Click" ToolTipService.ToolTip="Create a new folder in the active pane (Ctrl+Shift+N)" />
        <AppBarButton Icon="Rename" Label="Rename" Click="RenameSelected_Click" ToolTipService.ToolTip="Rename the selected item (F2)" />
        <AppBarButton Icon="View" Label="Preview" Click="PreviewSelected_Click" ToolTipService.ToolTip="Read-only viewer and integrated media player" />
        <AppBarButton Icon="View" Label="Properties" Click="PropertiesSelected_Click" ToolTipService.ToolTip="View properties of the selected item (Alt+Enter)" />
        <AppBarButton Icon="Calendar" Label="TimeVault" Click="TimeVault_Click" ToolTipService.ToolTip="Discover existing Windows shadow copies (read-only)" />
        <AppBarButton Icon="View" Label="Inspect Archive" Click="InspectZip_Click" ToolTipService.ToolTip="Read-only ZIP, TAR, or TGZ contents" />
        <AppBarButton Icon="Save" Label="Create Archive" Click="CreateZip_Click" ToolTipService.ToolTip="Create ZIP, TAR, or TAR.GZ from selected files and folders" />
        <AppBarButton Icon="Cancel" Label="Cancel Create" Click="CancelZipCreation_Click" ToolTipService.ToolTip="Request cancellation of active archive creation" />
        <AppBarButton Icon="Folder" Label="Extract Archive" Click="ExtractZip_Click" ToolTipService.ToolTip="Confirm extraction into a new no-overwrite folder" />
        <AppBarButton Icon="Cancel" Label="Cancel Extract" Click="CancelZipExtraction_Click" ToolTipService.ToolTip="Request cancellation of active archive extraction" />
        <AppBarButton Icon="Setting" Label="Tools">
          <AppBarButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Folder DNA" Click="FolderDna_Click" ToolTipService.ToolTip="Profile the current folder without scanning subfolders" />
              <MenuFlyoutItem Text="Operation Simulator" Click="PreviewShelf_Click" ToolTipService.ToolTip="Inspect all collected items against the active folder without copying anything" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Save Capsule" Click="SaveCapsule_Click" ToolTipService.ToolTip="Save current shelf path references locally; file contents are not copied" />
              <MenuFlyoutItem Text="View Capsules" Click="ViewCapsules_Click" ToolTipService.ToolTip="Review locally saved task references, including unavailable paths" />
              <MenuFlyoutSeparator />
              <ToggleMenuFlyoutItem x:Name="DetailsStripMenuItem" Text="Details panel" Click="DetailsStripMenuItem_Click" ToolTipService.ToolTip="Show or hide the details panel beside the panes (Ctrl+Shift+D)" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Settings" Click="Settings_Click" ToolTipService.ToolTip="Theme, density, and accent color preferences">
                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </AppBarButton.Flyout>
        </AppBarButton>
        <AppBarButton Icon="Delete" Label="Delete" Click="DeleteSelected_Click" ToolTipService.ToolTip="Move the selected items to the Recycle Bin (Delete)" />
        <AppBarSeparator />
        <AppBarButton x:Name="CancelCopyButton" Icon="Cancel" Label="Cancel copy" IsEnabled="False" Click="CancelCopy_Click" ToolTipService.ToolTip="Cancel the copy in progress (Esc)" />
        <AppBarButton Icon="Refresh" Label="Refresh both" Click="RefreshBoth_Click" ToolTipService.ToolTip="Refresh both panes (F5)" />
        <AppBarButton Icon="OpenLocal" Label="Open in Explorer" Click="OpenInExplorer_Click" ToolTipService.ToolTip="Open the active pane's folder in Explorer (Ctrl+Shift+E)" />
      </CommandBar>
    </Grid>
    <Grid Grid.Row="1" Margin="{StaticResource MeridianChromeMargin}" RowDefinitions="Auto,Auto">
      <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="ORGANIZE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
        <ToggleButton x:Name="BookmarksSectionToggle" Grid.Column="1" Content="Bookmarks" Click="OrganizeSection_Click" ToolTipService.ToolTip="Show or hide saved locations" />
        <ToggleButton x:Name="ShelfSectionToggle" Grid.Column="2" Content="Drop Shelf" Click="OrganizeSection_Click" ToolTipService.ToolTip="Show or hide the Drop Shelf tools" />
      </Grid>
      <Grid x:Name="BookmarksSection" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Content="★ Add bookmark" Click="AddBookmark_Click" />
        <Button Grid.Column="1" Content="Remove bookmark" Click="RemoveBookmark_Click" />
        <TextBlock Grid.Column="2" Text="SAVED LOCATIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
        <ComboBox x:Name="BookmarksBox" Grid.Column="3" PlaceholderText="Jump to a saved location…" DisplayMemberPath="Name" SelectionChanged="BookmarksBox_SelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Saved locations" />
      </Grid>
      <Grid x:Name="ShelfSection" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Content="＋ Shelf selected" Click="AddToShelf_Click" ToolTipService.ToolTip="Collect the selected file or folder without moving it" />
        <Button Grid.Column="1" Content="Remove from shelf" Click="RemoveFromShelf_Click" />
        <Button Grid.Column="2" Content="Clear shelf" Click="ClearShelf_Click" />
        <Button Grid.Column="3" Content="Prune missing" Click="PruneShelf_Click" ToolTipService.ToolTip="Remove missing paths from the shelf without deleting files" />
        <Button Grid.Column="4" Content="Show location" Click="ShowShelfLocation_Click" />
        <Button Grid.Column="5" Content="Preview shelf → active folder" Click="PreviewShelf_Click" ToolTipService.ToolTip="Inspect all collected items against the active folder without copying anything" />
        <Button Grid.Column="6" Content="Copy shelf…" Click="CopyShelf_Click" ToolTipService.ToolTip="Preview and confirm a no-overwrite batch copy" />
        <Button x:Name="CancelShelfButton" Grid.Column="7" Content="Cancel batch" Click="CancelShelf_Click" IsEnabled="False" />
        <ComboBox x:Name="ShelfItemsBox" Grid.Column="8" PlaceholderText="Drop Shelf · collect items from any folder" HorizontalAlignment="Stretch" AutomationProperties.Name="Drop Shelf items" />
      </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
      <Grid x:Name="SidebarPanel" Grid.Column="0" Width="212" Background="{ThemeResource MeridianPanelBrush}" BorderBrush="{ThemeResource MeridianBorderBrush}" BorderThickness="0,0,1,0" RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SidebarContent" Spacing="2" Padding="8" />
        </ScrollViewer>
        <Button Grid.Row="1" Margin="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click" ToolTipService.ToolTip="Theme, density, and accent color preferences" AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <SymbolIcon Symbol="Setting" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Grid x:Name="WorkAreaGrid" Grid.Column="1" Margin="{StaticResource MeridianWorkAreaMargin}" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftPaneColumn" Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="RightPaneColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="LeftPaneRoot" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{ThemeResource MeridianPanelBrush}" BorderThickness="0,2,0,0" BorderBrush="{ThemeResource MeridianBorderBrush}" PointerPressed="LeftPane_PointerPressed">
        <Grid x:Name="LeftPaneHeader" Padding="{StaticResource MeridianPaneHeaderMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="01" Foreground="{ThemeResource MeridianTextTertiaryBrush}" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Spacing="0">
            <TextBlock x:Name="LeftFolderName" Text="Source pane" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="LeftFolderPath" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Click="LeftBack_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back, left pane"><SymbolIcon Symbol="Back" /></Button><Button Grid.Column="1" Click="LeftForward_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward, left pane"><SymbolIcon Symbol="Forward" /></Button><Button Grid.Column="2" Click="LeftUp_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Up" AutomationProperties.Name="Up, left pane"><SymbolIcon Symbol="Up" /></Button>
          <TextBox x:Name="LeftPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="LeftPath_KeyDown" AutomationProperties.Name="Folder path, left pane" />
        </Grid>
        <Grid x:Name="LeftFilterRow" Grid.Row="2" Margin="{StaticResource MeridianPaneRowMargin}" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="LeftFilter" PlaceholderText="Filter files and folders…" TextChanged="LeftFilter_TextChanged" AutomationProperties.Name="Filter, left pane" />
          <ComboBox x:Name="LeftSort" Grid.Column="1" MinWidth="110" SelectedIndex="0" SelectionChanged="LeftSort_SelectionChanged" ToolTipService.ToolTip="Sort this pane" AutomationProperties.Name="Sort, left pane">
            <ComboBoxItem Content="Name" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Size" /><ComboBoxItem Content="Modified" />
          </ComboBox>
          <ToggleButton x:Name="LeftSortDescending" Grid.Column="2" Content="↓" ToolTipService.ToolTip="Descending sort" AutomationProperties.Name="Descending sort, left pane" Checked="LeftSortDirection_Changed" Unchecked="LeftSortDirection_Changed" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="LeftStandardLayoutToggle" Padding="6,2" Click="LeftStandardLayout_Click" ToolTipService.ToolTip="Standard list layout (Ctrl+Shift+V switches the active pane)" AutomationProperties.Name="Standard layout, left pane">
              <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="List" /><TextBlock Text="List" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="LeftColumnsLayoutToggle" Padding="6,2" Click="LeftColumnsLayout_Click" ToolTipService.ToolTip="Columns layout (Ctrl+Shift+V switches the active pane)" AutomationProperties.Name="Columns layout, left pane">
              <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="ViewAll" /><TextBlock Text="Columns" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="LeftDetailsViewToggle" Padding="6,2" Click="LeftDetailsView_Click" ToolTipService.ToolTip="Details view — name, size, age and modified columns" AutomationProperties.Name="Details view, left pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Bullets" /><TextBlock Text="Details" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="LeftGridViewToggle" Padding="6,2" Click="LeftGridView_Click" ToolTipService.ToolTip="Grid view — large thumbnails with names below" AutomationProperties.Name="Grid view, left pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Pictures" /><TextBlock Text="Grid" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="LeftTilesViewToggle" Padding="6,2" Click="LeftTilesView_Click" ToolTipService.ToolTip="Tiles view — medium thumbnails with type and size" AutomationProperties.Name="Tiles view, left pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="View" /><TextBlock Text="Tiles" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Group" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
              <ComboBox x:Name="LeftGroup" MinWidth="100" SelectedIndex="0" SelectionChanged="LeftGroup_SelectionChanged" ToolTipService.ToolTip="Group this pane's items by type, date or size" AutomationProperties.Name="Grouping, left pane">
                <ComboBoxItem Content="None" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Date" /><ComboBoxItem Content="Size" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Grid>
        <ListView x:Name="LeftItems" Grid.Row="3" SelectionMode="Extended" DoubleTapped="LeftItems_DoubleTapped" PointerPressed="LeftItems_PointerPressed" KeyDown="LeftItems_KeyDown" SelectionChanged="LeftItems_SelectionChanged" ContainerContentChanging="LeftItems_ContainerContentChanging" ItemTemplate="{StaticResource DetailsAllItemTemplate}" ItemsPanel="{StaticResource VerticalItemsPanel}" Background="Transparent" BorderThickness="0" Margin="4,0" AutomationProperties.Name="File list, left pane">
          <ListView.GroupStyle>
            <GroupStyle HeaderTemplate="{StaticResource PaneGroupHeaderTemplate}" HidesIfEmpty="True" />
          </ListView.GroupStyle>
          <ListView.ContextFlyout>
            <MenuFlyout Opening="LeftContextMenu_Opening">
              <MenuFlyoutItem x:Name="LeftCopyMenuItem" Text="Copy to right pane" Click="CopyLeftToRight_Click" />
              <MenuFlyoutItem x:Name="LeftMoveMenuItem" Text="Move to right pane" Click="MoveLeftToRight_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="LeftRenameMenuItem" Text="Rename" Click="RenameFromLeft_Click" />
              <MenuFlyoutItem x:Name="LeftPropertiesMenuItem" Text="Properties" Click="PropertiesFromLeft_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="LeftShelfMenuItem" Text="Add to Drop Shelf" Click="AddToShelfFromLeft_Click" />
              <MenuFlyoutItem x:Name="LeftDeleteMenuItem" Text="Delete (Recycle Bin)" Click="DeleteFromLeft_Click" />
            </MenuFlyout>
          </ListView.ContextFlyout>
        </ListView>
        <ScrollViewer x:Name="LeftColumnsView" Grid.Row="3" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" AutomationProperties.Name="Columns, left pane">
          <StackPanel x:Name="LeftColumnsPanel" Orientation="Horizontal" />
        </ScrollViewer>
        <ScrollViewer x:Name="LeftHomeView" Grid.Row="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Home, left pane">
          <StackPanel x:Name="LeftHomePanel" Spacing="10" Padding="10" />
        </ScrollViewer>
        <TextBlock x:Name="LeftStatus" Grid.Row="4" Text="Ready" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="{StaticResource MeridianPaneStatusMargin}" />
      </Grid>
      <Grid Grid.Column="1" Width="36" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
        <Button Grid.Row="0" Content="→" ToolTipService.ToolTip="Copy selected item to right pane" AutomationProperties.Name="Copy to right pane" Click="CopyLeftToRight_Click" />
        <Button Grid.Row="1" Content="←" ToolTipService.ToolTip="Copy selected item to left pane" AutomationProperties.Name="Copy to left pane" Click="CopyRightToLeft_Click" />
        <TextBlock Grid.Row="2" Text="COPY" FontSize="9" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" />
        <Border Grid.Row="3" Height="24" Background="Transparent" ToolTipService.ToolTip="Drag to resize the panes" AutomationProperties.Name="Resize panes" PointerPressed="SplitGrip_PointerPressed" PointerMoved="SplitGrip_PointerMoved" PointerReleased="SplitGrip_PointerReleased" PointerCaptureLost="SplitGrip_PointerCaptureLost">
          <TextBlock Text="↔" FontSize="12" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <Grid x:Name="RightPaneRoot" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{ThemeResource MeridianPanelBrush}" BorderThickness="0,2,0,0" BorderBrush="{ThemeResource MeridianBorderBrush}" PointerPressed="RightPane_PointerPressed">
        <Grid x:Name="RightPaneHeader" Padding="{StaticResource MeridianPaneHeaderMargin}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="02" Foreground="{ThemeResource MeridianTextTertiaryBrush}" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Spacing="0">
            <TextBlock x:Name="RightFolderName" Text="Destination pane" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="RightFolderPath" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="{StaticResource MeridianPaneRowMargin}" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
          <Button Click="RightBack_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Back" AutomationProperties.Name="Back, right pane"><SymbolIcon Symbol="Back" /></Button><Button Grid.Column="1" Click="RightForward_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward, right pane"><SymbolIcon Symbol="Forward" /></Button><Button Grid.Column="2" Click="RightUp_Click" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Up" AutomationProperties.Name="Up, right pane"><SymbolIcon Symbol="Up" /></Button>
          <TextBox x:Name="RightPath" Grid.Column="3" PlaceholderText="Enter a folder path…" KeyDown="RightPath_KeyDown" AutomationProperties.Name="Folder path, right pane" />
        </Grid>
        <Grid x:Name="RightFilterRow" Grid.Row="2" Margin="{StaticResource MeridianPaneRowMargin}" RowDefinitions="Auto,Auto" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
          <TextBox x:Name="RightFilter" PlaceholderText="Filter files and folders…" TextChanged="RightFilter_TextChanged" AutomationProperties.Name="Filter, right pane" />
          <ComboBox x:Name="RightSort" Grid.Column="1" MinWidth="110" SelectedIndex="0" SelectionChanged="RightSort_SelectionChanged" ToolTipService.ToolTip="Sort this pane" AutomationProperties.Name="Sort, right pane">
            <ComboBoxItem Content="Name" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Size" /><ComboBoxItem Content="Modified" />
          </ComboBox>
          <ToggleButton x:Name="RightSortDescending" Grid.Column="2" Content="↓" ToolTipService.ToolTip="Descending sort" AutomationProperties.Name="Descending sort, right pane" Checked="RightSortDirection_Changed" Unchecked="RightSortDirection_Changed" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="RightStandardLayoutToggle" Padding="6,2" Click="RightStandardLayout_Click" ToolTipService.ToolTip="Standard list layout (Ctrl+Shift+V switches the active pane)" AutomationProperties.Name="Standard layout, right pane">
              <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="List" /><TextBlock Text="List" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="RightColumnsLayoutToggle" Padding="6,2" Click="RightColumnsLayout_Click" ToolTipService.ToolTip="Columns layout (Ctrl+Shift+V switches the active pane)" AutomationProperties.Name="Columns layout, right pane">
              <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="ViewAll" /><TextBlock Text="Columns" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="RightDetailsViewToggle" Padding="6,2" Click="RightDetailsView_Click" ToolTipService.ToolTip="Details view — name, size, age and modified columns" AutomationProperties.Name="Details view, right pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Bullets" /><TextBlock Text="Details" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="RightGridViewToggle" Padding="6,2" Click="RightGridView_Click" ToolTipService.ToolTip="Grid view — large thumbnails with names below" AutomationProperties.Name="Grid view, right pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Pictures" /><TextBlock Text="Grid" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="RightTilesViewToggle" Padding="6,2" Click="RightTilesView_Click" ToolTipService.ToolTip="Tiles view — medium thumbnails with type and size" AutomationProperties.Name="Tiles view, right pane">
                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="View" /><TextBlock Text="Tiles" VerticalAlignment="Center" /></StackPanel>
              </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Group" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" VerticalAlignment="Center" />
              <ComboBox x:Name="RightGroup" MinWidth="100" SelectedIndex="0" SelectionChanged="RightGroup_SelectionChanged" ToolTipService.ToolTip="Group this pane's items by type, date or size" AutomationProperties.Name="Grouping, right pane">
                <ComboBoxItem Content="None" /><ComboBoxItem Content="Type" /><ComboBoxItem Content="Date" /><ComboBoxItem Content="Size" />
              </ComboBox>
            </StackPanel>
          </Grid>
        </Grid>
        <ListView x:Name="RightItems" Grid.Row="3" SelectionMode="Extended" DoubleTapped="RightItems_DoubleTapped" PointerPressed="RightItems_PointerPressed" KeyDown="RightItems_KeyDown" SelectionChanged="RightItems_SelectionChanged" ContainerContentChanging="RightItems_ContainerContentChanging" ItemTemplate="{StaticResource DetailsAllItemTemplate}" ItemsPanel="{StaticResource VerticalItemsPanel}" Background="Transparent" BorderThickness="0" Margin="4,0" AutomationProperties.Name="File list, right pane">
          <ListView.GroupStyle>
            <GroupStyle HeaderTemplate="{StaticResource PaneGroupHeaderTemplate}" HidesIfEmpty="True" />
          </ListView.GroupStyle>
          <ListView.ContextFlyout>
            <MenuFlyout Opening="RightContextMenu_Opening">
              <MenuFlyoutItem x:Name="RightCopyMenuItem" Text="Copy to left pane" Click="CopyRightToLeft_Click" />
              <MenuFlyoutItem x:Name="RightMoveMenuItem" Text="Move to left pane" Click="MoveRightToLeft_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="RightRenameMenuItem" Text="Rename" Click="RenameFromRight_Click" />
              <MenuFlyoutItem x:Name="RightPropertiesMenuItem" Text="Properties" Click="PropertiesFromRight_Click" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="RightShelfMenuItem" Text="Add to Drop Shelf" Click="AddToShelfFromRight_Click" />
              <MenuFlyoutItem x:Name="RightDeleteMenuItem" Text="Delete (Recycle Bin)" Click="DeleteFromRight_Click" />
            </MenuFlyout>
          </ListView.ContextFlyout>
        </ListView>
        <ScrollViewer x:Name="RightColumnsView" Grid.Row="3" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" AutomationProperties.Name="Columns, right pane">
          <StackPanel x:Name="RightColumnsPanel" Orientation="Horizontal" />
        </ScrollViewer>
        <ScrollViewer x:Name="RightHomeView" Grid.Row="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Home, right pane">
          <StackPanel x:Name="RightHomePanel" Spacing="10" Padding="10" />
        </ScrollViewer>
        <TextBlock x:Name="RightStatus" Grid.Row="4" Text="Ready" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="{StaticResource MeridianPaneStatusMargin}" />
      </Grid>
    </Grid>
      <Grid x:Name="DetailsStrip" Grid.Column="2" Width="324" Background="{ThemeResource MeridianPanelBrush}" BorderBrush="{ThemeResource MeridianBorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Padding="12" Spacing="10">
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
              <FontIcon x:Name="DetailsThumbnailGlyph" Glyph="&#xE946;" FontSize="40" Foreground="{ThemeResource MeridianTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="DetailsThumbnail" Width="96" Height="96" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Preview of the selected item" />
            </Grid>
            <TextBlock x:Name="DetailsHintText" FontSize="12" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <Grid ColumnDefinitions="92,*" ColumnSpacing="8" RowSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="File name" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsName" Grid.Column="1" Text="Details" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="Opens in" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsOpensInText" Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="File type" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsTypeText" Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="File size" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsSizeText" Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Text="Dimensions" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsDimensionsText" Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="Created" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsCreatedText" Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Text="Modified" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsModifiedText" Grid.Row="6" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Text="Accessed" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsAccessedText" Grid.Row="7" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="8" Text="Location" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
              <TextBlock x:Name="DetailsLocationText" Grid.Row="8" Grid.Column="1" FontSize="12" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
            <TextBlock x:Name="DetailsExifText" FontSize="12" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <Expander Header="Security" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="Who can open this item; permission changes are made in Windows">
              <StackPanel Spacing="6">
                <TextBlock Text="Visibility, permissions" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
                <TextBlock x:Name="DetailsAccessText" FontSize="12" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Button x:Name="DetailsSecurityButton" Content="Open Windows security settings…" HorizontalAlignment="Left" Click="DetailsSecurityButton_Click" AutomationProperties.Name="Open Windows security settings" ToolTipService.ToolTip="Open this item's Windows Properties dialog. Permissions are changed on its Security tab; Meridian only shows them" />
              </StackPanel>
            </Expander>
            <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="Details stored inside the file: title, comment, keywords, rating">
              <StackPanel Spacing="4">
                <TextBlock Text="Previous versions, tags" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
                <TextBlock Text="Title" FontSize="11" Foreground="{ThemeResource MeridianDialogLabelBrush}" />
                <TextBox x:Name="DetailsTitleBox" AutomationProperties.Name="Title" ToolTipService.ToolTip="The title stored inside the file" />
                <TextBlock Text="Comment" FontSize="11" Foreground="{ThemeResource MeridianDialogLabelBrush}" />
                <TextBox x:Name="DetailsCommentBox" AutomationProperties.Name="Comment" ToolTipService.ToolTip="A comment stored inside the file" />
                <TextBlock Text="Keywords (tags)" FontSize="11" Foreground="{ThemeResource MeridianDialogLabelBrush}" />
                <TextBox x:Name="DetailsKeywordsBox" AutomationProperties.Name="Keywords" ToolTipService.ToolTip="Separate tags with semicolons, like beach; sunset" />
                <TextBlock Text="Rating" FontSize="11" Foreground="{ThemeResource MeridianDialogLabelBrush}" />
                <RatingControl x:Name="DetailsRating" MaxRating="5" HorizontalAlignment="Left" AutomationProperties.Name="Rating" ToolTipService.ToolTip="The star rating stored inside the file" />
                <TextBlock x:Name="DetailsEditReason" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Button x:Name="DetailsReviewButton" Content="Review changes…" HorizontalAlignment="Left" Click="DetailsReviewButton_Click" AutomationProperties.Name="Review detail changes" ToolTipService.ToolTip="See exactly what will change, then confirm before anything is saved" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="{StaticResource MeridianStatusBarMargin}" ColumnDefinitions="Auto,*,Auto,Auto" Background="{ThemeResource MeridianPanelBrush}">
      <FontIcon x:Name="StatusIcon" Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource MeridianTextSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.Name="Status: information" />
      <TextBlock Grid.Column="1" x:Name="GlobalStatus" Text="Ready · Local-only · No telemetry" ToolTipService.ToolTip="Meridian · Preview build — early development" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel x:Name="OperationProgressPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="OperationProgressLabel" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
        <ProgressBar x:Name="OperationProgressBar" Width="160" VerticalAlignment="Center" AutomationProperties.Name="Operation progress" />
      </StackPanel>
      <Button x:Name="DismissStatusButton" Grid.Column="3" Margin="8,0,0,0" Padding="4" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="DismissStatus_Click" ToolTipService.ToolTip="Dismiss message" AutomationProperties.Name="Dismiss message" VerticalAlignment="Center">
        <SymbolIcon Symbol="Cancel" />
      </Button>
    </Grid>
    <Grid x:Name="QuickPreviewOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" IsTabStop="True" KeyDown="QuickPreviewOverlay_KeyDown">
      <Border Background="{ThemeResource MeridianSurfaceBrush}" Opacity="0.88" />
      <Border MaxWidth="920" MaxHeight="660" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource MeridianPanelBrush}" BorderBrush="{ThemeResource MeridianBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource MeridianCardCornerRadius}">
        <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock x:Name="QuickPreviewTitle" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource MeridianTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="QuickPreviewPosition" FontSize="11" Foreground="{ThemeResource MeridianTextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Click="QuickPreviewCloseButton_Click" ToolTipService.ToolTip="Close the preview (Space or Esc)" AutomationProperties.Name="Close preview" VerticalAlignment="Top" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuickPreviewPanel" Spacing="8" MinWidth="480" />
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="↑ / ↓ or ← / → move between files · Space or Esc closes" FontSize="11" Foreground="{ThemeResource MeridianTextTertiaryBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>